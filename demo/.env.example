# Base Sepolia RPC, or http://127.0.0.1:8545 for an Anvil fork rehearsal
RPC_URL=https://sepolia.base.org
# Printed by `npm run fork-setup` (Anvil) or by script/DeployUsdcEscrow.s.sol (Base Sepolia)
ESCROW_ADDRESS=

# One key per role. Never reuse real keys here.
# buyer:    holds USDC (https://faucet.circle.com); needs ETH only for the `release` scenario
# seller:   needs ETH for gas (it submits funding and settlement transactions)
BUYER_PK=
SELLER_PK=
# The human verifier's browser-wallet address (MetaMask, Rabby, ...). Pass it as VERIFIER at deploy.
# Its key never touches the demo: verdicts are signed on the review page.
VERIFIER_ADDRESS=

ANTHROPIC_API_KEY=
# Optional
BUDGET_USDC=5
EXPLORER_URL=https://sepolia.basescan.org
REVIEW_PORT=8787
